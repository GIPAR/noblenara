      <angularJerkLimit>${50.0 * 0.9}</angularJerkLimit>
  </plugin>
</gazebo>
-->

 <!-- Updated Hokuyo Link ROS2 -->
 <gazebo reference="hokuyo_link">
    <sensor type="gpu_lidar" name="head_hokuyo_sensor">
      <pose>0 0 0 0 0 0</pose>
      <topic>/noblenara/scan</topic>
      <update_rate>40</update_rate>
      <enable_metrics>false</enable_metrics>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-1.570796</min_angle>
            <max_angle>1.570796</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <!-- Noise parameters based on published spec for Hokuyo laser
               achieving "+-30mm" accuracy at range < 10m.  A mean of 0.0m and
               stddev of 0.01m will put 99.7% of samples within 0.03m of the true
               reading. -->
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

<!-- Updated Cameras for ROS2 - User + Depth-->
<gazebo reference="camera_link">
  <sensor name="camera_link_zed2i" type="rgbd_camera">
    <pose>0 0 0 0 0 0</pose>
    <topic>/noblenara/camera_link</topic>
    <update_rate>15</update_rate>  <!-- ZED 2i typical framerate -->
    <camera>
      <horizontal_fov>1.91986</horizontal_fov>  <!-- ~110° ZED 2i FOV -->
      <image>
        <width>640</width>  <!-- ZED 2i max resolution is 1920x1080 | Res Abaixada para a simulação ser mais leve -->
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.2</near>    <!-- ZED 2i min range -->
        <far>20.0</far>     <!-- ZED 2i max range -->
      </clip>
    </camera>
    <always_on>true</always_on>
    <visualize>false</visualize>
  </sensor>
</gazebo>

<!-- camera -->
  <gazebo reference="camera_user_link">
    <sensor type="camera" name="camera_user">
      <pose>0 0 0 0 0 0</pose>
      <topic>/noblenara/camera_user</topic>
      <update_rate>30.0</update_rate>
      <camera name="head">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>800</width>
          <height>800</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <!-- Noise is sampled independently per pixel on each frame.
               That pixel's noise value is added to each of its color
               channels, which at that point lie in the range [0,1]. -->
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

</robot>
