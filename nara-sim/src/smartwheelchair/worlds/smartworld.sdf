    <!-- ===== BASE/HOME (spawn do camaro) =====
         O disco verde/anel branco foram REMOVIDOS: ficavam na altura do
         LiDAR (z=0.06) e geravam um anel de obstaculos falsos em volta do
         robo no costmap, travando a navegacao. O spawn continua em
         (x=-4.0, y=0) no meio do lobby definido no gazebo.launch.py. -->

    <!-- ========== CAMERA INICIAL ========== -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>10 -18 14 0 0.6 1.57</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

